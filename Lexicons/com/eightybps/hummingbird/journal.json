{
  "lexicon": 1,
  "id": "com.eightybps.hummingbird.journal",
  "description": "An immutable Hummingbird profile mutation. Records form a grow-only event set and are keyed by eventID.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["eventID", "collection", "recordKey", "operation", "timestamp"],
        "properties": {
          "eventID": { "type": "string", "maxLength": 36 },
          "collection": { "type": "string", "format": "nsid" },
          "recordKey": { "type": "string", "maxLength": 512 },
          "operation": { "type": "string", "knownValues": ["put", "delete"] },
          "payload": { "type": "unknown" },
          "timestamp": { "type": "ref", "ref": "com.eightybps.hummingbird.defs#version" }
        }
      }
    }
  }
}
